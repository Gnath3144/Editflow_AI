# Editflow AI - Central Environment Configuration Template
# Copy this file to .env and configure your local settings.

# === Workspace & Storage ===
EDITFLOW_ROOT=D:\Codealytica\Editflow AI
RAW_RECORDINGS_ROOT=D:\Codealytica
ENHANCED_VIDEOS_ROOT=D:\Codealytica\Enhanced_Videos

# === Audio & DSP ===
TARGET_INTEGRATED_LUFS=-16.0
MAX_TRUE_PEAK_DBTP=-1.5
AUDIO_SAMPLE_RATE=48000

# === Cloud Providers (Optional) ===
# Azure Speech Services
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# Azure Translator
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=eastus

# OpenAI / Anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ElevenLabs
ELEVENLABS_API_KEY=

# === YouTube Publishing ===
YOUTUBE_CLIENT_SECRETS_FILE=config\youtube\client_secrets.json
YOUTUBE_TOKEN_FILE=config\youtube\token.json
YOUTUBE_DEFAULT_PLAYLIST=PLIkXO9w8SPGg
