# AutoEdit Configuration
# This tool has NO required environment variables and NO secrets/credentials.
# There is exactly one OPTIONAL variable, read via os.environ.get() with a
# safe default, so the tool runs correctly even if this file is never copied.
#
# Copy this file to .env only if you want to override the caption font:
# cp .env.example .env

# === Optional ===
# Font used for burned-in karaoke captions (passed to libass via the ASS
# subtitle style). Any font installed on the system works; if the named
# font is not found, libass substitutes automatically.
# Default: Impact
AUTOEDIT_FONT=Impact
