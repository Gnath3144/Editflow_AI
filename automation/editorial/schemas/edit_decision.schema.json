{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EditDecision",
  "type": "object",
  "required": [
    "decision_id",
    "start_time",
    "end_time",
    "duration",
    "action",
    "category",
    "confidence",
    "rule_reference",
    "semantic_impact"
  ],
  "properties": {
    "decision_id": {
      "type": "string"
    },
    "start_time": {
      "type": "number",
      "minimum": 0.0
    },
    "end_time": {
      "type": "number",
      "minimum": 0.0
    },
    "duration": {
      "type": "number",
      "minimum": 0.0
    },
    "action": {
      "type": "string",
      "enum": [
        "KEEP",
        "REMOVE",
        "SHORTEN",
        "REPLACE_WITH_NATURAL_CUT",
        "RETAIN_AS_CONTEXT",
        "SEPARATE_SPEAKERS",
        "HUMAN_REVIEW"
      ]
    },
    "category": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "rule_reference": {
      "type": "string"
    },
    "semantic_impact": {
      "type": "string"
    },
    "crossfade_ms": {
      "type": "number"
    }
  }
}