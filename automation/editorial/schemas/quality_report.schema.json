{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QualityReport",
  "type": "object",
  "required": [
    "target_lesson",
    "overall_pass",
    "acoustic_qc",
    "speaker_qc",
    "semantic_qc",
    "technical_qc"
  ],
  "properties": {
    "target_lesson": {
      "type": "string"
    },
    "overall_pass": {
      "type": "boolean"
    },
    "acoustic_qc": {
      "type": "object",
      "required": [
        "pass",
        "integrated_lufs",
        "true_peak_dbtp",
        "snr_db"
      ],
      "properties": {
        "pass": {
          "type": "boolean"
        },
        "integrated_lufs": {
          "type": "number"
        },
        "true_peak_dbtp": {
          "type": "number"
        },
        "snr_db": {
          "type": "number"
        }
      }
    },
    "speaker_qc": {
      "type": "object",
      "required": [
        "pass",
        "instructor_purity_pct"
      ],
      "properties": {
        "pass": {
          "type": "boolean"
        },
        "instructor_purity_pct": {
          "type": "number"
        }
      }
    },
    "semantic_qc": {
      "type": "object",
      "required": [
        "pass",
        "word_truncation_count",
        "filler_removal_rate"
      ],
      "properties": {
        "pass": {
          "type": "boolean"
        },
        "word_truncation_count": {
          "type": "integer"
        },
        "filler_removal_rate": {
          "type": "number"
        }
      }
    },
    "technical_qc": {
      "type": "object",
      "required": [
        "pass",
        "video_codec",
        "frame_rate",
        "resolution"
      ],
      "properties": {
        "pass": {
          "type": "boolean"
        },
        "video_codec": {
          "type": "string"
        },
        "frame_rate": {
          "type": "number"
        },
        "resolution": {
          "type": "string"
        }
      }
    }
  }
}