{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VoiceProfile",
  "type": "object",
  "required": [
    "engine",
    "profiles"
  ],
  "properties": {
    "engine": {
      "type": "string"
    },
    "fallback_engine": {
      "type": "string"
    },
    "profiles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "provider_voice_id",
          "sample_rate"
        ],
        "properties": {
          "provider_voice_id": {
            "type": "string"
          },
          "sample_rate": {
            "type": "integer"
          }
        }
      }
    }
  }
}