{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TranslatedSegment",
  "type": "object",
  "required": [
    "segment_id",
    "start_time",
    "end_time",
    "original_text",
    "translated_text"
  ],
  "properties": {
    "segment_id": {
      "type": "string"
    },
    "start_time": {
      "type": "number",
      "minimum": 0.0
    },
    "end_time": {
      "type": "number",
      "minimum": 0.0
    },
    "original_text": {
      "type": "string"
    },
    "translated_text": {
      "type": "string"
    },
    "pacing_adjustment": {
      "type": "number"
    },
    "audio_drift_ms": {
      "type": "number"
    }
  }
}